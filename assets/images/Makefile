# roomLights.webp is the master (1400x980, the 500x350 aspect ratio).
# Homey App Store requires 250x175, 500x350 and 1000x700 (see app-store guidelines).
convert:
	magick roomLights.webp -resize 250x175 roomLights-small.png
	magick roomLights.webp -resize 500x350 roomLights-large.png
	magick roomLights.webp -resize 1000x700 roomLights-xlarge.png
