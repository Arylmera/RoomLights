{
	"id": "inc.lemer.roomLights",
	"version": "1.0.0",
	"compatibility": ">=12.9.0",
	"sdk": 3,
	"platforms": ["local"],
	"name": {
		"en": "RoomLights"
	},
	"description": {
		"en": "Let you control all the lights in a defined Homey zone at once",
		"fr": "Contrôlez d'un coup toutes les lumières d'une zone Homey"
	},
	"category": ["lights"],
	"permissions": ["homey:manager:api"],
	"api": {
		"getLights": {
			"method": "GET",
			"path": "/lights"
		},
		"setRoles": {
			"method": "PUT",
			"path": "/roles"
		}
	},
	"images": {
		"small": "/assets/images/roomLights-small.png",
		"large": "/assets/images/roomLights-large.png",
		"xlarge": "/assets/images/roomLights-xlarge.png"
	},
	"brandColor": "#308511",
	"author": {
		"name": "Guillaume Lemer",
		"email": "guillaume@lemer.be"
	}
}
